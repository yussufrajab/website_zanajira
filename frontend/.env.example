# Tume ya Utumishi Serikalini — Frontend Environment Variables
#
# Directus has been decommissioned. The Next.js app serves the admin UI
# and JSON API directly (see /docs/DIRECTUS_TO_NEXTJS_API_MIGRATION_PLAN.md).

# Site URL (used for canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=https://zanajira.go.tz

# Database (PostgreSQL, shared with the existing tume_cms instance)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tume_cms

# Auth
AUTH_SECRET=<generate a strong random string with: openssl rand -base64 32>
AUTH_MAX_AGE_SECONDS=43200    # 12 hours (optional, default)

# File upload storage
UPLOAD_DRIVER=local            # "local" or "s3"
UPLOAD_LOCAL_DIR=public/uploads

# S3/MinIO (only when UPLOAD_DRIVER=s3)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=tume-web-assets
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PUBLIC_URL=http://127.0.0.1:9000/tume-web-assets

# Optional: Google Maps API key (for Contact Us map)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Contact Form SMTP (for admin replies)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme@gmail.com
SMTP_PASS=changeme_app_password
MAIL_FROM=changeme@gmail.com
CONTACT_EMAIL=info@zanajira.go.tz

# Rate Limiting (contact form)
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=3600000

# Google AI API key for AI-powered Swahili→English translation
# Used by the admin forms and auto-translation hooks.
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=