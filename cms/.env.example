# Tume ya Utumishi Serikalini — Directus CMS Environment Variables

PORT=8055

# PostgreSQL
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tume_cms
DB_USER=tume_app
DB_PASSWORD=changeme_strong_password

# MinIO Storage
STORAGE_LOCATIONS=minio
MINIO_ENDPOINT=192.168.1.103
MINIO_PORT=9000
MINIO_KEY=minio_access_key
MINIO_SECRET=minio_secret_key
MINIO_BUCKET=tume-web-assets
MINIO_PUBLIC_URL=https://zanajira.go.tz/assets
MINIO_S3_FORCE_PATH_STYLE=true

# Admin Account (used on first run)
ADMIN_EMAIL=admin@zanajira.go.tz
ADMIN_PASSWORD=Ch4ng3M3_Str0ng!Pass

# Security
SECRET=change-this-to-a-random-secret-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
CORS_ENABLED=true
CORS_ORIGIN=https://zanajira.go.tz